{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "ignorePatterns": ["node_modules/", "redesigns/"],
  "rules": {
    "no-undef": "error",
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-redeclare": "error",
    "no-duplicate-case": "error",
    "no-unreachable": "error",
    "no-constant-condition": "warn",
    "no-debugger": "warn",
    "no-empty": ["warn", { "allowEmptyCatch": true }],
    "no-extra-semi": "warn",
    "no-func-assign": "error",
    "no-inner-declarations": "warn",
    "no-invalid-regexp": "error",
    "no-irregular-whitespace": "warn",
    "no-unexpected-multiline": "error",
    "use-isnan": "error",
    "valid-typeof": "error",
    "eqeqeq": ["warn", "always"],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-wrappers": "error"
  },
  "globals": {
    "firebase": "readonly",
    "Sentry": "readonly",
    "FirebaseService": "readonly",
    "AuthService": "readonly",
    "PortfolioManager": "readonly",
    "GAAdmin": "readonly",
    "VisitorTracker": "readonly",
    "Analytics": "readonly",
    "Reporting": "readonly",
    "Agents": "readonly",
    "Pipeline": "readonly",
    "Orchestrator": "readonly",
    "OutreachEngine": "readonly",
    "CommandCenter": "readonly",
    "searchRemoteJobs": "writable"
  },
  "overrides": [
    {
      "files": ["functions/**/*.js"],
      "parserOptions": { "sourceType": "module" },
      "env": { "worker": true }
    },
    {
      "files": ["test/**/*.mjs", "**/*.mjs"],
      "parserOptions": { "sourceType": "module" },
      "env": { "node": true, "es2022": true }
    },
    {
      "files": ["firebase-config.js"],
      "rules": { "no-redeclare": "off" }
    }
  ]
}
