{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-redeclare": "error",
    "no-duplicate-case": "error",
    "no-unreachable": "error",
    "no-constant-condition": "warn",
    "no-debugger": "warn",
    "no-empty": "warn",
    "no-extra-semi": "warn",
    "no-func-assign": "error",
    "no-inner-declarations": "error",
    "no-invalid-regexp": "error",
    "no-irregular-whitespace": "warn",
    "no-unexpected-multiline": "error",
    "use-isnan": "error",
    "valid-typeof": "error",
    "eqeqeq": ["warn", "always"],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-wrappers": "error"
  },
  "globals": {
    "firebase": "readonly",
    "FirebaseService": "readonly",
    "AuthService": "readonly",
    "PortfolioManager": "readonly",
    "GAAdmin": "readonly",
    "Sentry": "readonly"
  }
}
