rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Leads collection — admin only reads, anyone can write (form submissions)
    match /leads/{leadId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create: if true;
      allow update: if request.auth != null && request.auth.token.admin == true;
      allow delete: if request.auth != null && request.auth.token.admin == true;

      // Notes subcollection — admin only
      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.token.admin == true;
      }

      // Timeline subcollection — admin only
      match /timeline/{entryId} {
        allow read, write: if request.auth != null && request.auth.token.admin == true;
      }
    }

    // Settings collection — admin only
    match /settings/{docId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // Campaigns collection — admin only
    match /campaigns/{campaignId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // Feedback collection — admin only
    match /feedback/{feedbackId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
