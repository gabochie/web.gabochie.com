{
  "name": "wg-portal",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [
      { "name": "PORTAL_HUB", "class_name": "PortalHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PortalHub"] }
  ],
  "routes": [
    { "pattern": "web.gabochie.com/api/portal/*", "zone_name": "gabochie.com" },
    { "pattern": "web.gabochie.com/api/lead", "zone_name": "gabochie.com" },
    { "pattern": "web.gabochie.com/api/lead/admin/list", "zone_name": "gabochie.com" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
